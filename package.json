    "check": "node scripts/check.ts",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "better-auth": "^1.7.15",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "pg": "^8.23.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.8"
  }
